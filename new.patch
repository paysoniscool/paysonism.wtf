+function graphPeakBoost(graph) {
+  if (eqState.bypass || !eqState.autoHeadroom) return 0;
+  const sampleRate = graph.context.sampleRate;
+  const maxFrequency = Math.min(20000, sampleRate * 0.49);
+  let maximumDb = 0;
+  // Match the RBJ peaking-EQ transfer function used by native BiquadFilterNodes.
+  // Sweeping the combined response makes headroom track adjacent-band boosts rather than a preset guess.
+  for (let sample = 0; sample < 512; sample += 1) {
+    const frequency = 20 * (maxFrequency / 20) ** (sample / 511);
+    const omega = 2 * Math.PI * frequency / sampleRate;
+    const cosine = Math.cos(omega), sine = Math.sin(omega);
+    const cosine2 = Math.cos(2 * omega), sine2 = Math.sin(2 * omega);
+    let responseDb = 0;
+    EQ_BANDS.forEach(({ hz }, index) => {
+      const gain = eqState.gains[index];
+      if (!gain) return;
+      const center = Math.min(hz, sampleRate * 0.45);
+      const centerOmega = 2 * Math.PI * center / sampleRate;
+      const A = 10 ** (gain / 40);
+      const alpha = Math.sin(centerOmega) / (2 * 1.414);
+      const b0 = 1 + alpha * A, b1 = -2 * Math.cos(centerOmega), b2 = 1 - alpha * A;
+      const a0 = 1 + alpha / A, a1 = b1, a2 = 1 - alpha / A;
+      const nr = b0 + b1 * cosine + b2 * cosine2;
+      const ni = -b1 * sine - b2 * sine2;
+      const dr = a0 + a1 * cosine + a2 * cosine2;
+      const di = -a1 * sine - a2 * sine2;
+      responseDb += 10 * Math.log10(Math.max((nr * nr + ni * ni) / (dr * dr + di * di), 1e-12));
+    });
