diff --git a/tests/portfolio-pages.test.mjs b/tests/portfolio-pages.test.mjs
new file mode 100644
index 0000000..d6aa5b1
--- /dev/null
+++ b/tests/portfolio-pages.test.mjs
@@ -0,0 +1,101 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const read = (file) => readFile(path.join(root, file), "utf8");
+
+test("new pages reuse the Mercury shell and add no page-local styles", async () => {
+  for (const file of ["music.html", "music-player.html", "business.html", "projects.html"]) {
+    const html = await read(file);
+    assert.match(html, /href="css\/mercury\.css"/, `${file} uses the shared stylesheet`);
+    assert.match(html, /fonts\.googleapis\.com\/css2\?family=Michroma/);
+    assert.match(html, /id="mercury-banner"/);
+    assert.match(html, /id="content-area"/);
+    assert.match(html, /id="col-left"/);
+    assert.match(html, /id="col-right"/);
+    assert.match(html, /class="Cbox"/);
+    assert.match(html, /class="V(?:box|navbox)"/);
+    assert.doesNotMatch(html, /<style\b|style="/, `${file} does not add page-local styles`);
+    assert.match(html, /projects\.html/);
+    assert.match(html, /music\.html/);
+    assert.match(html, /business\.html/);
+  }
+  const music = await read("music.html");
+  const player = await read("music-player.html");
+  assert.match(music, /id="music-equalizer"/);
+  assert.match(player, /id="music-equalizer"/);
+  const css = await read("css/mercury.css");
+  assert.match(css, /"Bank Gothic", "Michroma"/);
+  assert.match(css, /\.eq-bands[\s\S]*grid-template-columns:\s*repeat\(10/);
+  assert.match(css, /\.archive-filter\[aria-current="true"\]/);
+});
+
+test("sample music and business records, MP3s, and their editable timelines are present", async () => {
+  const music = await import(path.join(root, "js", "music-data.js"));
+  const business = await import(path.join(root, "js", "business-data.js"));
+  assert.equal(music.musicCatalog.tracks.length, 2);
+  assert.ok(music.musicCatalog.tracks.every((track) => /SAMPLE|TEST/.test(`${track.title} ${track.description}`)));
+  assert.equal(music.musicCatalog.productionSetup.length, 1);
+  assert.equal(music.musicCatalog.platforms.length, 3);
+  assert.equal(business.companies.length, 2);
+  assert.ok(business.companies.every((company) => company.name.includes("SAMPLE")));
+  assert.ok(business.companies.every((company) => company.timeline.length >= 3));
+  assert.ok(business.companies.every((company) => company.score >= 0 && company.score <= 5));
+
+  for (const track of music.musicCatalog.tracks) {
+    const bytes = await readFile(path.join(root, track.audio));
+    assert.ok(bytes.length > 10000, `${track.audio} contains playable MP3 data`);
+    assert.equal(bytes[0], 0xff, `${track.audio} starts with an MPEG audio frame`);
+    assert.equal(bytes[1] & 0xe0, 0xe0, `${track.audio} has an MPEG sync header`);
+  }
+
+  const musicRenderer = await read("js/music.js");
+  assert.match(musicRenderer, /audio\.controls = true/);
+  assert.match(musicRenderer, /audio\.src = track\.audio/);
+  assert.match(musicRenderer, /music-player\.html\?track=/);
+  assert.match(musicRenderer, /createMediaElementSource/);
+  assert.match(musicRenderer, /createBiquadFilter/);
+  assert.match(musicRenderer, /filter\.type = "peaking"/);
+  assert.match(musicRenderer, /filter\.Q\.value = 1\.414/);
+  assert.match(musicRenderer, /setTargetAtTime/);
+  assert.match(musicRenderer, /autoHeadroom/);
+  assert.match(musicRenderer, /DynamicsCompressor/);
+  assert.match(musicRenderer, /localStorage/);
+
+  const businessRenderer = await read("js/business.js");
+  assert.match(businessRenderer, /company\.timeline/);
+  assert.match(businessRenderer, /company\.score/);
+  assert.match(businessRenderer, /company\.logo/);
+  assert.match(businessRenderer, /#\$\{safeId\(company, index\)\}/);
+});
+
+test("source-archive controls filter a paginated, deduplicated project catalogue", async () => {
+  const projects = await read("js/projects.js");
+  const html = await read("projects.html");
+  const build = await read("scripts/build.mjs");
+  const verify = await read("scripts/verify.mjs");
+  assert.match(projects, /api\.github\.com\/users\/430L\/repos/);
+  assert.match(projects, /gitlab\.com\/api\/v4/);
+  assert.match(projects, /per_page=100/);
+  assert.match(projects, /Promise\.allSettled/);
+  assert.match(projects, /identityKey/);
+  assert.match(projects, /cormemsysvulnerabledriver/);
+  assert.match(projects, /stargazers_count/);
+  assert.match(projects, /star_count/);
+  assert.match(projects, /archive\/refs\/heads/);
+  assert.match(projects, /\/\-\/archive\//);
+  assert.match(projects, /data-repository-filter/);
+  assert.match(projects, /applyRepositoryFilter/);
+  assert.match(projects, /repositorySources/);
+  assert.match(html, /data-repository-filter="gitlab"/);
+  assert.match(html, /data-repository-filter="github"/);
+  assert.match(html, /SOURCE CODE ARCHIVE/);
+
+  for (const page of ["music.html", "music-player.html", "business.html", "projects.html"]) {
+    assert.ok(build.includes(`"${page}"`), `${page} is copied to deploy output`);
+    assert.ok(verify.includes(`dist/client/${page}`), `${page} is verified in deploy output`);
+  }
+});
