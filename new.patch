+      size: null,
+      language: "",
+      created: repo.created_at,
+      updated: repo.last_activity_at,
+      archived: Boolean(repo.archived),
+      fork: Boolean(repo.forked_from_project),
+      visibility: repo.visibility || "public",
+      license: "",
+      topics: Array.isArray(repo.topics) ? repo.topics : Array.isArray(repo.tag_list) ? repo.tag_list : [],
+      homepage: "",
+      issuesUrl: `${baseUrl}/-/issues`,
+      releasesUrl: `${baseUrl}/-/releases`,
+      readmeUrl: repo.readme_url
+    };
+  });
+}
+
+function identityKey(name) {
+  const normalized = String(name || "").toLowerCase().replace(/[^a-z0-9]/g, "");
+  const aliases = new Map([["cormemsysvulnerabledriver", "cormemvulnerabledriver"]]);
+  return aliases.get(normalized) || normalized;
+}
+
+function mergeDuplicates(githubRepos, gitlabRepos) {
+  const groups = new Map();
+  [...gitlabRepos, ...githubRepos].forEach((repo) => {
+    const key = identityKey(repo.name);
+    if (!key) return;
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(repo);
+  });
+  return [...groups.values()]
+    .map((sources) => ({
+      name: sources[0].name,
+      sources,
+      description: sources.find((repo) => repo.description)?.description || "",
+      updated: sources.map((repo) => repo.updated).filter(Boolean).sort().at(-1) || ""
+    }))
+    .sort((a, b) => String(b.updated).localeCompare(String(a.updated)) || a.name.localeCompare(b.name));
+}
+
+function dateLabel(value) {
+  if (!value) return "";
+  const date = new Date(value);
+  return Number.isNaN(date.valueOf()) ? value : new Intl.DateTimeFormat("en", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" }).format(date);
+}
+
+function sourceIcon(platform) {
+  return platform === "GitLab" ? "theme/gitlab.svg" : "theme/github.svg";
+}
+
+function renderRepository(repo, parent) {
+  const card = element(parent, "div", "project-compact repository-card");
+  const platforms = repo.sources.map((source) => source.platform.toLowerCase()).join(" ");
+  card.dataset.repositorySources = platforms;
+  element(card, "p", "project-kicker", repo.sources.length > 1 ? "CROSS-HOST REPOSITORY MATCH" : "SOURCE REPOSITORY");
+  const title = element(card, "p", "project-title");
+  externalLink(title, repo.sources[0].url, repo.name);
+  element(card, "p", "project-description", repo.description || "No description provided by the repository owner.");
+
+  const actions = element(card, "div", "repository-actions");
+  repo.sources.forEach((source) => {
+    const platformLabel = source.platform === "GitLab" ? "GitLab source" : "GitHub source";
+    const sourceAnchor = externalLink(actions, source.url, platformLabel, "archive-source-link");
+    if (sourceAnchor) {
+      const image = element(sourceAnchor, "img", "archive-source-icon");
+      image.src = sourceIcon(source.platform);
+      image.alt = "";
+      sourceAnchor.insertBefore(image, sourceAnchor.firstChild);
+    }
+    iconLink(actions, source.zipUrl, "↓", `${source.platform} ZIP`);
+    iconLink(actions, source.cloneUrl, "⑂", `${source.platform} clone`);
+    if (source.readmeUrl) iconLink(actions, source.readmeUrl, "▤", "README");
+    if (source.issuesUrl) iconLink(actions, source.issuesUrl, "?", "Issues");
+    if (source.releasesUrl) iconLink(actions, source.releasesUrl, "◆", "Releases");
+    if (safeHttpUrl(source.homepage)) iconLink(actions, source.homepage, "↗", "Website");
+  });
+
+  repo.sources.forEach((source) => {
+    const metadata = element(card, "p", "project-meta repository-meta");
+    const details = [
+      ["★", "Stars", source.stars ?? 0],
+      ["⑂", "Forks", source.forks ?? 0],
+      source.watchers !== null && source.watchers !== undefined ? ["◉", "Watchers", source.watchers] : null,
+      source.openIssues !== null && source.openIssues !== undefined ? ["?", "Open issues", source.openIssues] : null,
+      source.language ? ["⌘", "Language", source.language] : null,
+      source.branch ? ["⑂", "Branch", source.branch] : null,
+      source.license ? ["▤", "License", source.license] : null,
+      source.created ? ["＋", "Created", dateLabel(source.created)] : null,
+      source.updated ? ["◷", "Updated", dateLabel(source.updated)] : null,
+      source.size !== null && source.size !== undefined ? ["▣", "Size", `${source.size} KB`] : null,
+      source.fork ? ["⑂", "Fork"] : null,
+      source.archived ? ["■", "Archived"] : null
+    ].filter(Boolean);
+    const provider = element(metadata, "span", "archive-meta-provider");
+    const providerIcon = element(provider, "img", "archive-meta-provider-icon");
+    providerIcon.src = sourceIcon(source.platform);
+    providerIcon.alt = "";
+    element(provider, "span", "", source.platform);
+    details.forEach(([icon, label, value]) => {
+      const item = element(metadata, "span", "archive-meta-item");
+      const glyph = element(item, "span", "archive-meta-icon", icon);
+      glyph.setAttribute("aria-hidden", "true");
+      item.appendChild(document.createTextNode(value === undefined ? label : `${label}: ${value}`));
+    });
+  });
+
+  const topics = [...new Set(repo.sources.flatMap((source) => source.topics || []))];
+  if (topics.length) {
+    const topicRow = element(card, "p", "project-meta repository-topics");
+    element(topicRow, "span", "archive-topic-heading", "TOPICS");
+    topics.forEach((topic) => element(topicRow, "span", "archive-topic", topic));
+  }
+}
+
+function applyRepositoryFilter(filter, combined) {
+  const cards = document.querySelectorAll(".repository-card");
+  let visible = 0;
+  cards.forEach((card) => {
+    const sources = card.dataset.repositorySources.split(" ");
+    const matches = filter === "all" || sources.includes(filter);
+    card.hidden = !matches;
+    if (matches) visible += 1;
+  });
+  document.querySelectorAll("[data-repository-filter]").forEach((control) => {
+    control.setAttribute("aria-current", String(control.dataset.repositoryFilter === filter));
+  });
+  const resultCount = document.getElementById("projects-result-count");
+  if (resultCount) resultCount.textContent = `Showing ${visible} of ${combined.length} unique repositories`;
+}
+
+async function load() {
+  const status = document.getElementById("projects-status");
+  const list = document.getElementById("projects-list");
+  const summary = document.getElementById("projects-summary");
+  if (!status || !list || !summary) return;
+  const results = await Promise.allSettled([fetchGitLabRepos(), fetchGitHubRepos()]);
+  const [gitlabResult, githubResult] = results;
+  const gitlab = gitlabResult.status === "fulfilled" ? gitlabResult.value : [];
+  const github = githubResult.status === "fulfilled" ? githubResult.value : [];
+  const failures = [];
+  list.replaceChildren();
+  if (gitlabResult.status === "rejected") failures.push(`GitLab: ${gitlabResult.reason?.message || "could not load"}`);
+  if (githubResult.status === "rejected") failures.push(`GitHub: ${githubResult.reason?.message || "could not load"}`);
+  const combined = mergeDuplicates(github, gitlab);
+  const duplicateCount = gitlab.length + github.length - combined.length;
+  const gitlabUnique = combined.filter((entry) => entry.sources.some((source) => source.platform === "GitLab")).length;
+  const githubUnique = combined.filter((entry) => entry.sources.some((source) => source.platform === "GitHub")).length;
+  summary.textContent = `${combined.length} UNIQUE REPOSITORIES. ${duplicateCount} CROSS-HOST MATCHES COMBINED.`;
+
+  const countAll = document.getElementById("filter-count-all");
+  const countGitLab = document.getElementById("filter-count-gitlab");
+  const countGitHub = document.getElementById("filter-count-github");
+  if (countAll) countAll.textContent = `(${combined.length})`;
+  if (countGitLab) countGitLab.textContent = `(${gitlabUnique})`;
+  if (countGitHub) countGitHub.textContent = `(${githubUnique})`;
+  if (combined.length) combined.forEach((repo) => renderRepository(repo, list));
+  else element(list, "p", "", "No repository records could be loaded. Use the source profile links above to browse each public archive.");
+
+  if (failures.length) {
+    status.textContent = `PARTIAL CATALOGUE — ${failures.join("; ")}. Counts may be incomplete; refresh later.`;
+  } else {
+    status.textContent = "LIVE CATALOGUE COMPLETE — both public source archives responded.";
+  }
+  document.querySelectorAll("[data-repository-filter]").forEach((control) => {
+    control.addEventListener("click", (event) => {
+      event.preventDefault();
+      applyRepositoryFilter(control.dataset.repositoryFilter, combined);
+    });
+  });
+  applyRepositoryFilter("all", combined);
+}
+
+load().catch((error) => {
+  const status = document.getElementById("projects-status");
+  if (status) status.textContent = `Could not load repository archives: ${error.message || "unknown error"}. Use the source profile links above.`;
+});
