diff --git a/js/business.js b/js/business.js
new file mode 100644
index 0000000..4bbed26
--- /dev/null
+++ b/js/business.js
@@ -0,0 +1,108 @@
+import { companies } from "./business-data.js";
+
+const entries = Array.isArray(companies) ? companies : [];
+
+function add(parent, tag, className, text) {
+  const element = document.createElement(tag);
+  if (className) element.className = className;
+  if (text !== undefined && text !== null) element.textContent = text;
+  parent.appendChild(element);
+  return element;
+}
+
+function safeId(company, index) {
+  const source = String(company.id || company.name || `company-${index + 1}`)
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-|-$/g, "");
+  return `company-${source || index + 1}`;
+}
+
+function yearRange(company) {
+  const start = company.startYear || "YEAR TBD";
+  const end = company.endYear || (company.current ? "PRESENT" : "");
+  return end ? `${start} – ${end}` : String(start);
+}
+
+function renderSidebar() {
+  const timeline = document.getElementById("business-timeline");
+  if (!timeline) return;
+  timeline.replaceChildren();
+  if (!entries.length) {
+    add(timeline, "p", "", "Company history will appear here when added.");
+    return;
+  }
+  const list = add(timeline, "ul", "");
+  entries.forEach((company, index) => {
+    const item = add(list, "li", "");
+    const anchor = add(item, "a", "sb-butn", `${yearRange(company)} | ${company.name || "Company"}`);
+    anchor.href = `#${safeId(company, index)}`;
+  });
+}
+
+function renderCompanies() {
+  const container = document.getElementById("business-companies");
+  if (!container) return;
+  container.replaceChildren();
+  if (!entries.length) {
+    add(container, "p", "", "Company profiles are ready to be added. Add a company record to js/business-data.js; its overview and individual achievements timeline will be generated here.");
+    return;
+  }
+
+  entries.forEach((company, index) => {
+    const panel = add(container, "section", "Cbox");
+    panel.id = safeId(company, index);
+    const top = add(panel, "div", "Ctop");
+    add(top, "div", "CTitle", company.name || "Company overview");
+    const mid = add(panel, "div", "Cmid");
+    const info = add(mid, "div", "CInfo");
+
+    if (company.logo || company.description || company.website) {
+      const overview = add(info, "div", "project-feature");
+      if (company.logo) {
+        const image = add(overview, "img", "project-thumb project-thumb-logo");
+        image.src = company.logo;
+        image.alt = `${company.name || "Company"} logo`;
+        image.loading = "lazy";
+      }
+      const copy = add(overview, "div", "project-copy");
+      add(copy, "p", "project-kicker", yearRange(company));
+      if (company.description) add(copy, "p", "project-description", company.description);
+      if (company.website) {
+        const website = add(copy, "p", "project-description");
+        const anchor = add(website, "a", "", company.websiteLabel || "Company website");
+        anchor.href = company.website;
+        if (/^https?:/i.test(company.website)) {
+          anchor.target = "_blank";
+          anchor.rel = "noopener noreferrer";
+        }
+      }
+    } else {
+      add(info, "p", "", company.description || "Company description has not been added yet.");
+      add(info, "p", "project-meta", yearRange(company));
+    }
+
+    const score = company.score === null || company.score === undefined || company.score === "" ? Number.NaN : Number(company.score);
+    const scoreText = Number.isFinite(score) && score >= 0 && score <= 5
+      ? `${score} / 5`
+      : "NOT RATED";
+    add(info, "p", "project-meta", `SUCCESS: ${scoreText}`);
+
+    const milestones = Array.isArray(company.timeline) ? company.timeline : [];
+    const heading = add(info, "p", "project-kicker", "COMPANY TIMELINE & ACHIEVEMENTS");
+    heading.id = `${panel.id}-timeline`;
+    if (!milestones.length) {
+      add(info, "p", "", "No milestones have been added for this company yet.");
+      return;
+    }
+    milestones.forEach((milestone) => {
+      const achievement = add(info, "div", "project-compact");
+      add(achievement, "p", "project-kicker", milestone.date || "DATE TBD");
+      add(achievement, "p", "project-title", milestone.title || "Achievement");
+      if (milestone.description) add(achievement, "p", "project-description", milestone.description);
+    });
+  });
+}
+
+renderSidebar();
+renderCompanies();
